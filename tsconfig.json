{
  "compilerOptions": {
    "types": [
      "jest",
      "node"
    ],
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    // Required by Nest's tsconfig-paths-webpack-plugin to resolve @app/* at build
    // time -- removing it breaks `nest build`. TS 6.0 deprecates it; once the
    // project moves off TS 5.x, add "ignoreDeprecations": "6.0" (invalid on 5.9).
    "baseUrl": ".",
    "paths": {
      "@app/common": [
        "./libs/common/src"
      ],
      "@app/common/*": [
        "./libs/common/src/*"
      ]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}